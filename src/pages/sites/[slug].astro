---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import TestList from '../../components/TestList.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getAllReports, getReportBySlug, getPassRate, formatDuration, formatDate } from '../../utils/reports';

export function getStaticPaths() {
  const reports = getAllReports();
  return reports.map(report => ({
    params: { slug: report.slug },
  }));
}

const { slug } = Astro.params;
const report = getReportBySlug(slug!);

if (!report) {
  return Astro.redirect('/sites');
}

const passed = report.tests.filter(t => t.status === 'pass').length;
const failed = report.tests.filter(t => t.status === 'fail').length;
const passRate = getPassRate(report);
---

<DashboardLayout title={report.name}>
  <div class="mb-6">
    <a href="/sites" class="text-sm text-primary-600 hover:text-primary-700 hover:underline">
      ← Volver a sitios
    </a>
  </div>

  <div class="mb-8">
    <h1 class="text-2xl font-bold text-slate-900 mb-1">{report.name}</h1>
    <a href={report.url} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-primary-600 hover:underline">
      {report.url}
    </a>
    {report.description && (
      <p class="text-slate-500 mt-2">{report.description}</p>
    )}
  </div>

  {report.hasReport ? (
    <>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
          <p class="text-sm font-medium text-slate-500 mb-1">Tests</p>
          <p class="text-3xl font-bold text-slate-900">{report.tests.length}</p>
        </div>
        <div class="bg-green-50 rounded-xl border border-green-200 shadow-sm p-5">
          <p class="text-sm font-medium text-slate-500 mb-1">Pasaron</p>
          <p class="text-3xl font-bold text-green-600">{passed}</p>
        </div>
        <div class="bg-red-50 rounded-xl border border-red-200 shadow-sm p-5">
          <p class="text-sm font-medium text-slate-500 mb-1">Fallaron</p>
          <p class="text-3xl font-bold text-red-500">{failed}</p>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-5">
          <p class="text-sm font-medium text-slate-500 mb-1">Tiempo total</p>
          <p class="text-3xl font-bold text-slate-900">{formatDuration(report.duration)}</p>
        </div>
      </div>

      {report.insights && report.insights.length > 0 && (
        <div class="mt-8 rounded-xl border border-amber-200 bg-amber-50 p-5">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-lg">💡</span>
            <h2 class="text-base font-semibold text-amber-900">Sugerencias de ADA</h2>
            <span class="text-xs text-amber-700/70 font-normal">— para este sitio</span>
          </div>
          <ul class="space-y-2">
            {report.insights.map(ins => (
              <li class="flex items-start gap-2 text-sm">
                <span>{ins.level === 'warning' ? '⚠️' : 'ℹ️'}</span>
                <span class="text-slate-700">{ins.message}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-slate-900">Tests ejecutados</h2>
        <span class="text-sm text-slate-500">
          Última ejecución: {formatDate(report.lastRun!)}
        </span>
      </div>

      <TestList tests={report.tests} />
    </>
  ) : (
    <EmptyState
      icon="⏳"
      message="Este sitio está registrado pero aún no tiene tests ejecutados. ADA ejecutará los tests pronto."
      actionLabel="Ejecutar tests ahora"
      actionHref="#"
    />
  )}

  <div class="mt-10 pt-6 border-t border-slate-200 flex flex-col sm:flex-row gap-3">
    <a
      href="#"
      class="inline-flex items-center justify-center gap-2 bg-primary-600 hover:bg-primary-700 text-white font-medium px-4 py-2.5 rounded-lg transition-colors"
    >
      Ejecutar tests ahora
    </a>
    <button
      id="delete-btn"
      class="inline-flex items-center justify-center gap-2 bg-white hover:bg-red-50 text-red-600 font-medium px-4 py-2.5 rounded-lg border border-red-200 transition-colors"
    >
      Eliminar sitio
    </button>
  </div>
</DashboardLayout>

<script>
  document.getElementById('delete-btn')?.addEventListener('click', () => {
    if (confirm('¿Estás seguro de que quieres eliminar este sitio? Esta acción no se puede deshacer.')) {
      alert('Sitio eliminado (demo). En la versión final se eliminaría de la base de datos.');
    }
  });
</script>
