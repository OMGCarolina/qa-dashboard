---
import {
  getDaysUntilExpiry,
  getExpiryStatusFromDomain,
  getExpiryStatusEmoji,
  getExpiryStatusLabel,
  getExpiryStatusColor,
  getExpiryBgColor,
  formatDate,
  maskPassword,
} from '../utils/dominios';
import type { Domain } from '../utils/dominios';

interface Props {
  domain: Domain;
}

const { domain } = Astro.props;
const daysLeft = getDaysUntilExpiry(domain.fechaExpiracion);
const expiryStatus = getExpiryStatusFromDomain(domain);
const emoji = getExpiryStatusEmoji(expiryStatus);
const label = getExpiryStatusLabel(expiryStatus);
const textColor = getExpiryStatusColor(expiryStatus);
const bgColor = getExpiryBgColor(expiryStatus);
const isExpired = expiryStatus === 'expired';
const isWarning = expiryStatus === 'warning';
---

<div class:list={['rounded-xl border shadow-sm p-5 transition-all hover:shadow-md', bgColor]}>
  <div class="flex items-start justify-between mb-3">
    <div class="min-w-0">
      <p class="text-lg font-semibold text-slate-900 truncate">
        {emoji} {domain.domain}
      </p>
      <p class="text-sm text-slate-500">{domain.propiedad} · {domain.registrador}</p>
    </div>
    <span class:list={[
      'text-xs font-medium px-2 py-1 rounded-full flex-shrink-0 ml-3',
      isExpired ? 'bg-red-100 text-red-700' :
      isWarning ? 'bg-yellow-100 text-yellow-700' :
      'bg-green-100 text-green-700',
    ]}>
      {label}
    </span>
  </div>

  <div class="space-y-2 mb-4">
    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-500">Expira</span>
      <span class:list={['font-medium', textColor]}>
        {isExpired ? 'VENCIDO' : formatDate(domain.fechaExpiracion)}
        {!isExpired && daysLeft > 0 && ` (${daysLeft} días)`}
      </span>
    </div>

    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-500">Registrado</span>
      <span class="font-medium text-slate-700">{formatDate(domain.fechaRegistro)}</span>
    </div>

    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-500">Renovación</span>
      <span class="font-medium">{domain.renovacionActiva ? '✅ Auto' : '❌ Manual'}</span>
    </div>

    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-500">Costo</span>
      <span class="font-medium text-slate-700">{domain.costoRenovacion}</span>
    </div>

    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-500">Cuenta</span>
      <span class="font-medium text-slate-700 text-xs">{domain.cuentaDelegada}</span>
    </div>
  </div>

  {!domain.renovacionActiva && (
    <div class="text-sm px-3 py-2 rounded-lg bg-yellow-100 text-yellow-700">
      ⚠️ Sin auto-renovación activa
    </div>
  )}

  {isExpired && (
    <div class="text-sm px-3 py-2 rounded-lg bg-red-100 text-red-700">
      ⚠️ Dominio vencido — requiere atención
    </div>
  )}
</div>
