---
import {
  getDaysUntilExpiry,
  getExpiryStatus,
  getExpiryStatusEmoji,
  getExpiryStatusColor,
  getExpiryBgColor,
  formatDate,
} from '../utils/dominios';
import type { Domain } from '../utils/dominios';

interface Props {
  domain: Domain;
}

const { domain } = Astro.props;
const daysLeft = getDaysUntilExpiry(domain.expires);
const expiryStatus = getExpiryStatus(domain.expires);
const emoji = getExpiryStatusEmoji(expiryStatus);
const textColor = getExpiryStatusColor(expiryStatus);
const bgColor = getExpiryBgColor(expiryStatus);
const isExpired = expiryStatus === 'expired';
---

<div class:list={['rounded-xl border shadow-sm p-5 transition-all hover:shadow-md', bgColor]}>
  <div class="flex items-start justify-between mb-3">
    <div>
      <p class="text-lg font-semibold text-slate-900">
        {emoji} {domain.domain}
      </p>
      <p class="text-sm text-slate-500">{domain.cliente} · {domain.registrador}</p>
    </div>
    <span class:list={[
      'text-xs font-medium px-2 py-1 rounded-full',
      domain.status === 'ACTIVE'
        ? 'bg-green-100 text-green-700'
        : 'bg-slate-100 text-slate-600',
    ]}>
      {domain.status}
    </span>
  </div>

  <div class="space-y-2 mb-4">
    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-500">Expira</span>
      <span class:list={['font-medium', textColor]}>
        {isExpired ? 'VENCIDO' : formatDate(domain.expires)}
        {!isExpired && ` (${daysLeft} días)`}
      </span>
    </div>

    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-500">DNS</span>
      <span class="font-medium text-slate-700">☁️ {domain.dns}</span>
    </div>

    <div class="flex items-center justify-between text-sm">
      <span class="text-slate-500">Auto-renovación</span>
      <span class="font-medium">{domain.renewAuto ? '✅ Sí' : '❌ No'}</span>
    </div>
  </div>

  {domain.notas && (
    <div class:list={[
      'text-sm px-3 py-2 rounded-lg',
      isExpired ? 'bg-red-100 text-red-700' : 'bg-slate-100 text-slate-600',
    ]}>
      ⚠️ {domain.notas}
    </div>
  )}
</div>
