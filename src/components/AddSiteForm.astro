---

<form id="add-site-form" class="max-w-xl space-y-6">
  <div>
    <label for="site-name" class="block text-sm font-medium text-slate-700 mb-1">
      Nombre del sitio *
    </label>
    <input
      type="text"
      id="site-name"
      name="name"
      required
      placeholder="Ej: Jersey Canna"
      class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow"
    />
    <p id="slug-preview" class="mt-1 text-sm text-slate-400 hidden">
      Slug: <code class="bg-slate-100 px-1.5 py-0.5 rounded"></code>
    </p>
  </div>

  <div>
    <label for="site-url" class="block text-sm font-medium text-slate-700 mb-1">
      URL del sitio *
    </label>
    <input
      type="url"
      id="site-url"
      name="url"
      required
      placeholder="https://jersey-canna.com"
      class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow"
    />
  </div>

  <div>
    <label for="site-description" class="block text-sm font-medium text-slate-700 mb-1">
      Descripción <span class="text-slate-400">(opcional)</span>
    </label>
    <textarea
      id="site-description"
      name="description"
      rows="3"
      placeholder="Sitio WordPress de tienda de chocolates..."
      class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow resize-none"
    ></textarea>
  </div>

  <div>
    <label for="test-type" class="block text-sm font-medium text-slate-700 mb-1">
      Tipo de tests a generar
    </label>
    <select
      id="test-type"
      name="testType"
      class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow bg-white"
    >
      <option value="seo-functional">SEO + Funcionalidad (recomendado)</option>
      <option value="seo">Solo SEO</option>
      <option value="functional">Solo funcionalidad</option>
      <option value="custom">Personalizado</option>
    </select>
  </div>

  <div id="form-message" class="hidden rounded-lg p-4 text-sm"></div>

  <div id="post-save-actions" class="hidden p-4 bg-slate-50 border border-slate-200 rounded-lg">
    <p class="text-sm text-slate-700 mb-3">
      Sitio agregado correctamente. ¿Qué quieres hacer?
    </p>
    <div class="flex flex-col sm:flex-row gap-3">
      <button
        type="button"
        id="deploy-btn"
        class="flex-1 bg-primary-600 hover:bg-primary-700 text-white font-medium py-2.5 px-4 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Actualizar dashboard
      </button>
      <button
        type="button"
        id="run-tests-btn"
        disabled
        class="flex-1 bg-slate-400 text-white font-medium py-2.5 px-4 rounded-lg cursor-not-allowed"
      >
        Ejecutar tests (próximamente)
      </button>
    </div>
    <p id="deploy-status" class="hidden mt-3 text-sm"></p>
  </div>

  <button
    type="submit"
    id="submit-btn"
    class="w-full bg-primary-600 hover:bg-primary-700 text-white font-medium py-2.5 px-4 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
  >
    Agregar sitio y generar tests
  </button>
</form>

<script>
  const form = document.getElementById('add-site-form') as HTMLFormElement;
  const nameInput = document.getElementById('site-name') as HTMLInputElement;
  const slugPreview = document.getElementById('slug-preview');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const formMessage = document.getElementById('form-message');
  const postSaveActions = document.getElementById('post-save-actions');
  const deployBtn = document.getElementById('deploy-btn') as HTMLButtonElement;
  const deployStatus = document.getElementById('deploy-status');

  nameInput?.addEventListener('input', () => {
    const slug = nameInput.value
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');

    if (slug && slugPreview) {
      slugPreview.classList.remove('hidden');
      slugPreview.querySelector('code')!.textContent = slug;
    } else if (slugPreview) {
      slugPreview.classList.add('hidden');
    }
  });

  function showMessage(text: string, type: 'success' | 'error') {
    if (!formMessage) return;
    formMessage.textContent = text;
    formMessage.className = `rounded-lg p-4 text-sm ${
      type === 'success'
        ? 'bg-green-50 text-green-800 border border-green-200'
        : 'bg-red-50 text-red-800 border border-red-200'
    }`;
    formMessage.classList.remove('hidden');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    submitBtn.disabled = true;
    submitBtn.textContent = 'Agregando...';
    formMessage?.classList.add('hidden');

    const formData = new FormData(form);
    const name = (formData.get('name') as string).trim();
    const url = (formData.get('url') as string).trim();
    const description = (formData.get('description') as string)?.trim() || undefined;

    try {
      const res = await fetch('/api/add-site', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, url, description }),
      });

      const data = await res.json();

      if (!res.ok) {
        showMessage(data.error || 'Error al agregar sitio', 'error');
        return;
      }

      showMessage(
        `Sitio "${data.name}" agregado correctamente.`,
        'success'
      );
      form.reset();
      slugPreview?.classList.add('hidden');

      // Mostrar acciones post-guardado
      if (postSaveActions) {
        postSaveActions.classList.remove('hidden');
      }
    } catch {
      showMessage('Error de conexión', 'error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Agregar sitio y generar tests';
    }
  });

  // Deploy button handler
  deployBtn?.addEventListener('click', async () => {
    deployBtn.disabled = true;
    deployBtn.textContent = 'Actualizando...';
    deployStatus?.classList.remove('hidden');
    if (deployStatus) {
      deployStatus.className = 'mt-3 text-sm text-slate-600';
      deployStatus.textContent = 'Iniciando deploy...';
    }

    try {
      const res = await fetch('/api/deploy', { method: 'POST' });
      const data = await res.json();

      if (res.ok) {
        if (deployStatus) {
          deployStatus.className = 'mt-3 text-sm text-green-600';
          deployStatus.textContent = 'Deploy iniciado. El dashboard se actualizará en ~1 minuto.';
        }
      } else {
        if (deployStatus) {
          deployStatus.className = 'mt-3 text-sm text-red-600';
          deployStatus.textContent = data.error || 'Error al iniciar deploy';
        }
      }
    } catch {
      if (deployStatus) {
        deployStatus.className = 'mt-3 text-sm text-red-600';
        deployStatus.textContent = 'Error de conexión';
      }
    } finally {
      deployBtn.disabled = false;
      deployBtn.textContent = 'Actualizar dashboard';
    }
  });
</script>
