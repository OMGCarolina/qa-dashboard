---

<form id="add-site-form" class="max-w-xl space-y-6">
  <div id="token-section" class="hidden bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-4">
    <p class="text-sm text-yellow-800 mb-2">Necesitás configurar tu GitHub token para agregar sitios.</p>
    <div class="flex gap-2">
      <input
        type="password"
        id="github-token"
        placeholder="ghp_xxxxxxxxxxxx"
        class="flex-1 px-3 py-2 rounded-lg border border-yellow-300 text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none"
      />
      <button
        type="button"
        id="save-token-btn"
        class="bg-yellow-600 hover:bg-yellow-700 text-white text-sm font-medium px-3 py-2 rounded-lg transition-colors"
      >
        Guardar
      </button>
    </div>
  </div>

  <div>
    <label for="site-name" class="block text-sm font-medium text-slate-700 mb-1">
      Nombre del sitio *
    </label>
    <input
      type="text"
      id="site-name"
      name="name"
      required
      placeholder="Ej: Jersey Canna"
      class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow"
    />
    <p id="slug-preview" class="mt-1 text-sm text-slate-400 hidden">
      Slug: <code class="bg-slate-100 px-1.5 py-0.5 rounded"></code>
    </p>
  </div>

  <div>
    <label for="site-url" class="block text-sm font-medium text-slate-700 mb-1">
      URL del sitio *
    </label>
    <input
      type="url"
      id="site-url"
      name="url"
      required
      placeholder="https://jersey-canna.com"
      class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow"
    />
  </div>

  <div>
    <label for="site-description" class="block text-sm font-medium text-slate-700 mb-1">
      Descripción <span class="text-slate-400">(opcional)</span>
    </label>
    <textarea
      id="site-description"
      name="description"
      rows="3"
      placeholder="Sitio WordPress de tienda de chocolates..."
      class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow resize-none"
    ></textarea>
  </div>

  <div>
    <label for="test-type" class="block text-sm font-medium text-slate-700 mb-1">
      Tipo de tests a generar
    </label>
    <select
      id="test-type"
      name="testType"
      class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow bg-white"
    >
      <option value="seo-functional">SEO + Funcionalidad (recomendado)</option>
      <option value="seo">Solo SEO</option>
      <option value="functional">Solo funcionalidad</option>
      <option value="custom">Personalizado</option>
    </select>
  </div>

  <div id="form-message" class="hidden rounded-lg p-4 text-sm"></div>

  <button
    type="submit"
    id="submit-btn"
    class="w-full bg-primary-600 hover:bg-primary-700 text-white font-medium py-2.5 px-4 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
  >
    Agregar sitio y generar tests
  </button>
</form>

<script>
  const GITHUB_REPO = 'OMGCarolina/qa-dashboard';
  const SITES_FILE_PATH = 'src/data/sites.json';
  const GITHUB_API = 'https://api.github.com';

  function getToken(): string | null {
    return localStorage.getItem('gh_token');
  }

  function setToken(token: string) {
    localStorage.setItem('gh_token', token);
  }

  const form = document.getElementById('add-site-form') as HTMLFormElement;
  const nameInput = document.getElementById('site-name') as HTMLInputElement;
  const slugPreview = document.getElementById('slug-preview');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const formMessage = document.getElementById('form-message');
  const tokenSection = document.getElementById('token-section');
  const saveTokenBtn = document.getElementById('save-token-btn');
  const githubTokenInput = document.getElementById('github-token') as HTMLInputElement;

  if (!getToken()) {
    tokenSection?.classList.remove('hidden');
  }

  saveTokenBtn?.addEventListener('click', () => {
    const token = githubTokenInput?.value.trim();
    if (token) {
      setToken(token);
      tokenSection?.classList.add('hidden');
      showMessage('Token guardado correctamente', 'success');
    }
  });

  nameInput?.addEventListener('input', () => {
    const slug = nameInput.value
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');

    if (slug && slugPreview) {
      slugPreview.classList.remove('hidden');
      slugPreview.querySelector('code')!.textContent = slug;
    } else if (slugPreview) {
      slugPreview.classList.add('hidden');
    }
  });

  function showMessage(text: string, type: 'success' | 'error') {
    if (!formMessage) return;
    formMessage.textContent = text;
    formMessage.className = `rounded-lg p-4 text-sm ${
      type === 'success'
        ? 'bg-green-50 text-green-800 border border-green-200'
        : 'bg-red-50 text-red-800 border border-red-200'
    }`;
    formMessage.classList.remove('hidden');
  }

  async function getFile(token: string) {
    const res = await fetch(`${GITHUB_API}/repos/${GITHUB_REPO}/contents/${SITES_FILE_PATH}`, {
      headers: {
        Authorization: `Bearer ${token}`,
        Accept: 'application/vnd.github.v3+json',
      },
    });
    if (!res.ok) throw new Error(`Error leyendo archivo: ${res.status}`);
    return res.json();
  }

  async function commitFile(token: string, content: string, sha: string, message: string) {
    const res = await fetch(`${GITHUB_API}/repos/${GITHUB_REPO}/contents/${SITES_FILE_PATH}`, {
      method: 'PUT',
      headers: {
        Authorization: `Bearer ${token}`,
        Accept: 'application/vnd.github.v3+json',
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        message,
        content: btoa(unescape(encodeURIComponent(content))),
        sha,
      }),
    });
    if (!res.ok) {
      const err = await res.text();
      throw new Error(`Error commitando: ${res.status} ${err}`);
    }
    return res.json();
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const token = getToken();
    if (!token) {
      tokenSection?.classList.remove('hidden');
      showMessage('Configurá tu GitHub token primero', 'error');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Agregando...';
    formMessage?.classList.add('hidden');

    const formData = new FormData(form);
    const name = (formData.get('name') as string).trim();
    const url = (formData.get('url') as string).trim();
    const description = (formData.get('description') as string)?.trim() || undefined;

    const slug = name
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');

    try {
      const fileData = await getFile(token);
      const sites = JSON.parse(decodeURIComponent(escape(atob(fileData.content))));

      if (sites.some((s: { slug: string }) => s.slug === slug)) {
        showMessage(`Ya existe un sitio con el slug "${slug}"`, 'error');
        return;
      }

      sites.push({
        slug,
        name,
        url,
        description,
        addedAt: new Date().toISOString(),
      });

      const updatedContent = JSON.stringify(sites, null, 2) + '\n';
      await commitFile(token, updatedContent, fileData.sha, `add site: ${name} (${slug})`);

      showMessage(`Sitio "${name}" agregado correctamente. El dashboard se actualizará en ~1 minuto.`, 'success');
      form.reset();
      slugPreview?.classList.add('hidden');
    } catch (err) {
      showMessage(err instanceof Error ? err.message : 'Error desconocido', 'error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Agregar sitio y generar tests';
    }
  });
</script>
